# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Debug Mode (set DEBUG=true/1 or LOG_LEVEL=debug to show DEBUG logs; defaults to false/disabled)
# DEBUG=true
# LOG_LEVEL=debug

# LLM Provider selection: 'gemini' (default) or 'openai' (any OpenAI-compatible API)
# LLM_PROVIDER=gemini

# Gemini API Settings (using the new google-genai SDK; used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# Override the Gemini model (defaults to gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI-compatible Settings (used when LLM_PROVIDER=openai)
# Works with OpenAI, OpenRouter, Together, local servers (vLLM/Ollama), etc.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# Optional custom endpoint (defaults to https://api.openai.com/v1); no trailing slash needed
# OPENAI_BASE_URL=https://api.openai.com/v1

# SQLite Database Location (must not contain '..')
DB_PATH=data/bot_messages.db

# Timezone for date formatting in prompts (e.g. Europe/Moscow, UTC, etc.)
DEFAULT_TIMEZONE=Europe/Moscow

# Language for bot interface and summaries ('en' or 'ru', defaults to 'en')
BOT_LANGUAGE=en

# Rate Limiting (disabled by default, or when set to 0. Invalid or negative values fail-closed)
# RATE_LIMIT_MAX_REQUESTS=5
# RATE_LIMIT_WINDOW_SEC=3600

# Chat ID Authorization (Fail-Closed: no chats are allowed by default)
# To authorize specific chats, specify their IDs as a comma-separated list:
# ALLOWED_CHATS=-100123456789,-100987654321
#
# To explicitly bypass authorization and allow all chats, set this to true:
# ALLOW_ALL_CHATS=false
#
# Private Chat (DM) User ID Authorization
# To authorize only specific users to send private messages to the bot (preventing DMs from others),
# specify their numeric user IDs as a comma-separated list.
# Note: If ALLOWED_USERS is set, it restricts private messages (DMs) even if ALLOW_ALL_CHATS is true.
# ALLOWED_USERS=12345678,87654321

# PII Minimization Mode (set to true to replace real names/usernames in transcripts with stable pseudonyms)
# REDACT_USER_IDENTITIES=false

# Append a link to a source message for each topic in the summary.
# Works only in private supergroups/channels (t.me/c/ links). Default: false
# INCLUDE_MESSAGE_LINKS=false

# Multimodal Support (all disabled by default; works only with LLM_PROVIDER=gemini)
# Master switch — set to true to enable media logging and processing
# MULTIMODAL_ENABLED=false

# Per-type toggles: which media types to log
# MULTIMODAL_IMAGES_ENABLED=false
# MULTIMODAL_VOICE_ENABLED=false
# MULTIMODAL_VIDEO_NOTE_ENABLED=false

# When true, media always appears in summaries. When false, only when the user
# includes trigger keywords in their request (e.g. "с медиа", "with images").
# MULTIMODAL_INCLUDE_BY_DEFAULT=false

# Max disk space for stored media files (megabytes). Exceeding this deletes the
# oldest files first.
# MEDIA_STORAGE_MAX_MB=500

# Gemini Files API (Gemini provider only). When enabled, media is uploaded to
# Google and sent to the model by reference instead of inline base64, which
# removes the small inline per-type size caps. Uploaded files are retained by
# Google for ~48h. Modes:
#   off       — inline base64 only (default; conservative 1/3/5 MB caps)
#   ondemand  — upload local media at summarization time (always fresh URIs)
#   cache     — like ondemand, but cache the URI in the DB and reuse it across
#               summarizations within the 48h window
# MULTIMODAL_FILES_API=off

# When Files API is enabled, the per-type download caps are replaced by this
# single cap (megabytes). Telegram's Bot API will not serve files over 20 MB.
# MEDIA_MAX_DOWNLOAD_MB=20

